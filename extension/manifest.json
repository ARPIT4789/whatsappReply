{
"manifest_version": 3,
"name": "WhatsApp AI Reply",
"version": "1.0.0",
"description": "AI-assisted replies for WhatsApp Web",
"permissions": [
"storage"
],
"host_permissions": [
"https://web.whatsapp.com/*"
],
"content_scripts": [
{
"matches": [
"https://web.whatsapp.com/*"
],
"js": [
"content.js"
],
"css": [
"style.css"
],
"run_at": "document_idle"
}
],
"action": {
"default_popup": "popup.html",
"default_title": "WhatsApp AI Reply"
}
}
